#!/bin/bash

# omarchy:summary=Install 1Password and its Chromium extension.
# omarchy:requires-sudo=true

# On NixOS 1Password needs its system module (for the polkit and browser
# integration helpers), and Chromium extensions are forced through policy.
# omarchy-pkg-add prints the options when they are not set yet.

set -e

echo "Installing 1Password..."
if ! omarchy-pkg-present 1password 1password-cli; then
  omarchy-pkg-add 1password 1password-cli || {
    cat >&2 <<'MSG'

Add these to your NixOS configuration, then run omarchy-update:

  programs._1password.enable = true;
  programs._1password-gui = { enable = true; polkitPolicyOwners = [ "<your user>" ]; };
  programs.chromium.extensions = [ "aeblfdkhhhdcdjpifhhbdiojplfjncoa" ];  # 1Password for Chromium
MSG
    exit 1
  }
fi

echo "Opening 1Password..."
uwsm-app -- 1password >/dev/null 2>&1 &

echo ""
echo "1Password is installed. Its Chromium extension comes from programs.chromium.extensions."
