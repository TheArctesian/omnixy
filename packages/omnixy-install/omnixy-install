USERNAME_PATTERN='^[a-z_][a-z0-9_-]*$'
RESERVED_USERNAMES='^(root|bin|daemon|mail|ftp|http|nobody|nogroup|dbus|messagebus|sshd|nixbld[0-9]*|systemd-.*|tss|uuidd|git|avahi|cups|lp|polkituser|rtkit|qemu-libvirtd|pcscd|sddm|geoclue|colord|fwupd-refresh|docker|wheel|users)$'
HOSTNAME_PATTERN='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'

keyboard_row() {
  awk -F'|' -v k="$1" '$1 == k || $2 == k { print; exit }' <<<"$KEYBOARDS"
}

ask_keyboard() {
  local choice row
  if preset OMNIXY_INSTALL_KEYBOARD; then
    choice=$OMNIXY_INSTALL_KEYBOARD
  else
    need_tty OMNIXY_INSTALL_KEYBOARD
    choice=$(cut -d'|' -f1 <<<"$KEYBOARDS" |
      gum choose --height 10 --selected "English (US)" --header "Select keyboard layout")
  fi
  row=$(keyboard_row "$choice")
  [[ -n $row ]] || die "unknown keyboard layout: $choice"
  IFS='|' read -r keyboard_label console_keymap xkb_layout xkb_variant <<<"$row"
  # Non-Latin layouts get US alongside, toggled with Alt+Shift, so commands
  # and passwords stay typeable.
  xkb_options=""
  if [[ $xkb_layout == us,* ]]; then
    xkb_variant=",$xkb_variant"
    xkb_options="grp:alt_shift_toggle"
  fi
  # Type the rest of the form in the layout the new system will use.
  if ((!dry_run)); then
    command -v hyprctl >/dev/null && hyprctl keyword input:kb_layout "${xkb_layout%%,*}" >/dev/null 2>&1 || true
    [[ $(tty 2>/dev/null) == /dev/tty[0-9]* ]] && loadkeys "$console_keymap" >/dev/null 2>&1 || true
  fi
}

valid_username() {
  if ! [[ $1 =~ $USERNAME_PATTERN ]] || ((${#1} > 32)); then
    notice "Username must be lowercase letters, digits, - or _ (up to 32)"
  elif [[ $1 =~ $RESERVED_USERNAMES ]]; then
    notice "Username is reserved for the system"
  else
    return 0
  fi
  return 1
}

ask_username() {
  if preset OMNIXY_INSTALL_USERNAME; then
    username=$OMNIXY_INSTALL_USERNAME
    valid_username "$username" || exit 1
    return 0
  fi
  need_tty OMNIXY_INSTALL_USERNAME
  while true; do
    username=$(gum input --placeholder "Alphanumeric without spaces (like dhh)" \
      --prompt.foreground="$ACCENT" --prompt "Username> ")
    valid_username "$username" && return 0
  done
}

ask_password() {
  local confirmation
  if preset OMNIXY_INSTALL_PASSWORD; then
    password=$OMNIXY_INSTALL_PASSWORD
    [[ -n $password ]] || die "OMNIXY_INSTALL_PASSWORD is empty"
    return 0
  fi
  need_tty OMNIXY_INSTALL_PASSWORD
  while true; do
    password=$(gum input --password --placeholder "Used for your account, and disk encryption when enabled" \
      --prompt.foreground="$ACCENT" --prompt "Password> ")
    confirmation=$(gum input --password --placeholder "Must match the password you just typed" \
      --prompt.foreground="$ACCENT" --prompt "Confirm> ")
    if [[ -z $password ]]; then
      notice "Your password can't be blank!"
    elif [[ $password != "$confirmation" ]]; then
      notice "Passwords didn't match!"
    else
      return 0
    fi
  done
}

ask_identity() {
  if preset OMNIXY_INSTALL_FULL_NAME; then
    full_name=$OMNIXY_INSTALL_FULL_NAME
  else
    need_tty OMNIXY_INSTALL_FULL_NAME
    full_name=$(gum input --placeholder "Used for git authentication (hit return to skip)" \
      --prompt.foreground="$ACCENT" --prompt "Full name> ")
  fi
  if preset OMNIXY_INSTALL_EMAIL; then
    email=$OMNIXY_INSTALL_EMAIL
  else
    need_tty OMNIXY_INSTALL_EMAIL
    email=$(gum input --placeholder "Used for git authentication (hit return to skip)" \
      --prompt.foreground="$ACCENT" --prompt "Email address> ")
  fi
}

ask_hostname() {
  if preset OMNIXY_INSTALL_HOSTNAME; then
    hostname=${OMNIXY_INSTALL_HOSTNAME:-omnixy}
    [[ $hostname =~ $HOSTNAME_PATTERN ]] || die "invalid hostname: $hostname"
    return 0
  fi
  need_tty OMNIXY_INSTALL_HOSTNAME
  while true; do
    hostname=$(gum input --placeholder "Letters, digits, and dashes (or return for 'omnixy')" \
      --prompt.foreground="$ACCENT" --prompt "Hostname> ")
    hostname=${hostname:-omnixy}
    [[ $hostname =~ $HOSTNAME_PATTERN ]] && return 0
    notice "Hostname must be 1-63 letters, digits, or dashes, and cannot start or end with a dash"
  done
}

list_timezones() {
  timedatectl list-timezones 2>/dev/null ||
    awk '!/^#/ { print $3 }' "${TZDIR:-/etc/zoneinfo}/zone1970.tab" | sort
}

ask_timezone() {
  local guess=""
  if preset OMNIXY_INSTALL_TIMEZONE; then
    timezone=${OMNIXY_INSTALL_TIMEZONE:-UTC}
  else
    need_tty OMNIXY_INSTALL_TIMEZONE
    # A fresh machine often has no network yet, so the geo guess may fail.
    guess=$(timeout 5 tzupdate -p 2>/dev/null) || guess=""
    if [[ -n $guess ]]; then
      timezone=$(list_timezones | gum choose --height 10 --selected "$guess" --header "Timezone")
    else
      timezone=$(list_timezones | gum filter --height 10 --header "Timezone")
    fi
    timezone=${timezone:-UTC}
  fi
  # Not `list_timezones | grep -q`: under pipefail, grep quitting early can
  # SIGPIPE the lister and reject a valid zone.
  if [[ $timezone != UTC ]] && ! grep -qxF "$timezone" <<<"$(list_timezones)"; then
    die "unknown timezone: $timezone"
  fi
}

# omnixy.hardware for this machine, from omnixy-hardware-detect (always a Nix
# attrset). The detector derives the wireless regulatory domain from the live
# system's timezone, so that one is redone from the timezone chosen above.
detect_hardware() {
  local detected country="" body=""
  detected=$(omnixy-hardware-detect --nix 2>/dev/null) || detected=""
  if [[ $detected == "{"*"}" && $detected != "{ }" ]]; then
    body=$(sed -e '1d' -e '$d' <<<"$detected" | grep -v '^ *wirelessRegdom = ') || body=""
  fi
  if [[ $timezone != UTC ]]; then
    country=$(awk -F'\t' -v tz="$timezone" '!/^#/ && $3 == tz { print $1; exit }' \
      "${TZDIR:-/etc/zoneinfo}/zone.tab" 2>/dev/null) || country=""
    [[ $country =~ ^[A-Z]{2}$ ]] || country=""
  fi
  if [[ -n $country ]]; then
    body="  wirelessRegdom = \"$country\"; # from timezone $timezone${body:+$'\n'$body}"
  fi
  if [[ -n $body ]]; then
    hardware_nix="{"$'\n'"$body"$'\n'"}"
  else
    hardware_nix="{ }"
  fi
  # Option paths, for the summary.
  hardware_summary=$(sed -n 's/^ *\([A-Za-z0-9_.]*\) = .*/\1/p' <<<"$body" | paste -sd, - | sed 's/,/, /g')
  hardware_summary=${hardware_summary:-none needed}
}

# Whole, writable disks, without the medium the live system booted from.
list_disks() {
  local live="" src name size type ro model
  src=$(findmnt -nvo SOURCE /iso 2>/dev/null) || src=""
  [[ -n $src ]] && live=$(lsblk -npo PKNAME "$src" 2>/dev/null | head -1)
  [[ -z $live && -n $src ]] && live=$src
  while read -r name size type ro model; do
    [[ $type == disk && $ro == 0 && $name != "$live" && $name != /dev/zram* ]] || continue
    printf '%s\t%s\t%b\n' "$name" "$size" "${model:-unknown model}"
  done < <(lsblk -dnpr -o NAME,SIZE,TYPE,RO,MODEL 2>/dev/null)
}

disk_description() {
  local size model
  size=$(lsblk -dno SIZE "$1" 2>/dev/null | tr -d ' ') || size="?"
  model=$(lsblk -dno MODEL "$1" 2>/dev/null) || model=""
  printf '%s (%s, %s)' "$1" "${size:-?}" "${model:-unknown model}"
}

ask_disk() {
  local disks choice
  if preset OMNIXY_INSTALL_DISK; then
    disk=$OMNIXY_INSTALL_DISK
    [[ -n $disk ]] || die "OMNIXY_INSTALL_DISK is empty"
  else
    need_tty OMNIXY_INSTALL_DISK
    disks=$(list_disks)
    [[ -n $disks ]] || die "no installable disk found (lsblk shows no writable whole disk)"
    choice=$(awk -F'\t' '{ printf "%-16s %8s  %s\n", $1, $2, $3 }' <<<"$disks" |
      gum choose --header "Select install disk (everything on it will be erased)")
    disk=${choice%% *}
  fi
  if ((!dry_run)); then
    [[ -b $disk ]] || die "$disk is not a block device"
    [[ $(lsblk -dno TYPE "$disk") == disk ]] || die "$disk is not a whole disk"
  fi
  disk_label=$(disk_description "$disk")
}

ask_encryption() {
  local answer
  if preset OMNIXY_INSTALL_ENCRYPT; then
    answer=${OMNIXY_INSTALL_ENCRYPT,,}
  else
    need_tty OMNIXY_INSTALL_ENCRYPT
    if gum confirm --default=true "Encrypt the disk? (LUKS, unlocked with your password at boot)"; then
      answer=yes
    else
      answer=no
    fi
  fi
  case $answer in
    y | yes | 1 | true) encrypt=1 ;;
    n | no | 0 | false | "") encrypt=0 ;;
    *) die "OMNIXY_INSTALL_ENCRYPT must be yes or no" ;;
  esac
}

# --- Generated files ---------------------------------------------------------

# Nix string literal body: escape \, " and ${.
nix_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//\$\{/\\\$\{}
  printf '%s' "$s"
}

# btrfs, as upstream Omarchy installs: zstd compression roughly halves /nix,
# subvolumes keep /home and /nix apart from / for snapshots or a later
# impermanence setup, and nixos-generate-config detects the layout (subvol=
# options, the LUKS device) on its own. Rollback itself comes from NixOS
# generations, so no snapper/limine-snapshots are needed.
write_disko() {
  local root_content btrfs
  btrfs=$(
    cat <<EOF
{
            type = "btrfs";
            extraArgs = [ "-f" "-L" "nixos" ];
            subvolumes = {
              "@" = {
                mountpoint = "/";
                mountOptions = [ "compress=zstd" "noatime" ];
              };
              "@home" = {
                mountpoint = "/home";
                mountOptions = [ "compress=zstd" "noatime" ];
              };
              "@nix" = {
                mountpoint = "/nix";
                mountOptions = [ "compress=zstd" "noatime" ];
              };
              "@log" = {
                mountpoint = "/var/log";
                mountOptions = [ "compress=zstd" "noatime" ];
              };
            };
          }
EOF
  )
  if ((encrypt)); then
    root_content=$(
      cat <<EOF
{
            type = "luks";
            name = "cryptroot";
            passwordFile = "$luks_key";
            settings.allowDiscards = true;
            content = ${btrfs//$'\n'/$'\n'    };
          }
EOF
    )
  else
    root_content=$btrfs
  fi
  cat >"$1" <<EOF
# Written by omnixy-install and used once, to partition $disk.
# Not imported by the system: hardware-configuration.nix describes the result.
{
  disko.devices.disk.main = {
    type = "disk";
    device = "$disk";
    content = {
      type = "gpt";
      partitions = {
        ESP = {
          size = "1G";
          type = "EF00";
          content = {
            type = "filesystem";
            format = "vfat";
            extraArgs = [ "-n" "BOOT" ];
            mountpoint = "/boot";
            mountOptions = [ "umask=0077" ];
          };
        };
        root = {
          size = "100%";
          content = $root_content;
        };
      };
    };
  };
}
EOF
}

write_flake() {
  cat >"$1" <<EOF
{
  description = "$hostname: NixOS running OmniXY";

  inputs = {
    nixpkgs.url = "$NIXPKGS_URL";
    omnixy = {
      url = "$FLAKE_URL";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    { nixpkgs, omnixy, ... }:
    {
      # Rebuild with: sudo nixos-rebuild switch --flake /etc/nixos#$hostname
      # (or just \`omarchy-update\` from the desktop)
      nixosConfigurations."$hostname" = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          omnixy.nixosModules.default
          ./configuration.nix
        ];
      };
    };
}
EOF
}

write_configuration() {
  local fs mounts="" encryption="" autologin=""
  for fs in / /home /nix /var/log; do
    mounts+="  fileSystems.\"$fs\".options = [ \"compress=zstd\" \"noatime\" ];"$'\n'
  done
  if ((encrypt)); then
    encryption='
  # Full-disk encryption: the LUKS device itself is in
  # hardware-configuration.nix; the passphrase prompt is the Plymouth splash.
  boot.initrd.luks.devices.cryptroot.allowDiscards = true;
'
    autologin='    # The disk passphrase already authenticates you, as upstream.
    autoLogin = true;
'
  fi
  cat >"$1" <<EOF
# Written by omnixy-install. This is yours to edit; apply changes with
# \`omarchy-update\` or \`sudo nixos-rebuild switch --flake /etc/nixos#$hostname\`.
# Every OmniXY option: https://github.com/TheArctesian/omnixy#install
{ ... }:
{
  imports = [ ./hardware-configuration.nix ];

  omnixy = {
    enable = true;
    user = "$(nix_escape "$username")";
    fullName = "$(nix_escape "$full_name")";
    email = "$(nix_escape "$email")";
    theme = "Tokyo Night";
    # From omnixy-hardware-detect; run \`omnixy-hardware-detect --nix\` again
    # after changing hardware.
    hardware = ${hardware_nix//$'\n'/$'\n'    };
${autologin}    # preinstalls.enable = false; # skip LibreOffice, OBS, Kdenlive, ...
    # features.docker = false;
  };

  # Only applied when the account is created; change it later with \`passwd\`.
  users.users."$(nix_escape "$username")".initialHashedPassword = "$password_hash";

  networking.hostName = "$hostname"; # must match the name in flake.nix

  # time.timeZone is left unset so the Omarchy timezone menu (timedatectl) can
  # change it; the installer pointed /etc/localtime at $timezone.
  # Uncomment to pin it declaratively instead:
  # time.timeZone = "$timezone";

  # $keyboard_label
  console.keyMap = "$console_keymap";
  services.xserver.xkb = {
    layout = "$xkb_layout";
    variant = "$xkb_variant";
    options = "$xkb_options";
  };
  # i18n.defaultLocale = "en_US.UTF-8";

  boot.loader.systemd-boot.enable = true;
  boot.loader.systemd-boot.configurationLimit = 10;
  boot.loader.efi.canTouchEfiVariables = true;

  # btrfs subvolumes from the installer (subvol= is in hardware-configuration.nix).
$mounts  services.btrfs.autoScrub.enable = true;
${encryption}
  system.stateVersion = "$STATE_VERSION"; # don't change after install
}
EOF
}

# Stand-in for --dry-run, where nothing is mounted: the live machine's
# hardware detection plus the filesystems the disko layout above creates.
write_placeholder_hardware() {
  local detected root_dev=/dev/disk/by-label/nixos
  detected=$(nixos-generate-config --show-hardware-config --no-filesystems 2>/dev/null) || detected=""
  if [[ $(tail -n 1 <<<"$detected") != "}" ]]; then
    detected='{ lib, modulesPath, ... }:
{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];
  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}'
  fi
  {
    cat <<'EOF'
# DRY RUN placeholder: this machine's hardware detection plus the filesystems
# the disko layout creates. A real install writes the output of
# `nixos-generate-config --root /mnt --show-hardware-config` instead.
EOF
    sed '$d' <<<"$detected"
    echo
    if ((encrypt)); then
      echo '  boot.initrd.luks.devices."cryptroot".device = "/dev/disk/by-partlabel/disk-main-root";'
    fi
    cat <<EOF
  fileSystems."/" = { device = "$root_dev"; fsType = "btrfs"; options = [ "subvol=@" ]; };
  fileSystems."/home" = { device = "$root_dev"; fsType = "btrfs"; options = [ "subvol=@home" ]; };
  fileSystems."/nix" = { device = "$root_dev"; fsType = "btrfs"; options = [ "subvol=@nix" ]; };
  fileSystems."/var/log" = { device = "$root_dev"; fsType = "btrfs"; options = [ "subvol=@log" ]; };
  fileSystems."/boot" = { device = "/dev/disk/by-label/BOOT"; fsType = "vfat"; options = [ "umask=0077" ]; };
}
EOF
  } >"$1"
}

# --- Running -------------------------------------------------------------------

# Privileged commands. sudo resets the environment, so pass PATH through.
as_root() {
  if ((EUID == 0)); then
    "$@"
  else
    # disko's nix-build finds <nixpkgs> through NIX_PATH.
    sudo env PATH="$PATH" ${NIX_PATH:+NIX_PATH="$NIX_PATH"} "$@"
  fi
}

# Print in --dry-run, otherwise run as root.
run() {
  printf '+ %s\n' "$*"
  ((dry_run)) || as_root "$@"
}

ensure_network() {
  until curl -fsS --max-time 5 -o /dev/null https://cache.nixos.org/nix-cache-info; do
    interactive || die "no internet connection (needed to fetch the OmniXY flake)"
    notice "No internet connection. nixos-install needs one to fetch OmniXY." 0
    if gum confirm "Open the network manager (nmtui) to connect?"; then
      nmtui || true
    else
      die "no internet connection"
    fi
  done
}

lock_flake() {
  local dir=$1 args=()
  # The ISO's source and rev only describe the default flake, not a fork.
  if [[ $FLAKE_URL == "$DEFAULT_FLAKE_URL" && -n $OMNIXY_SOURCE ]] &&
    { ((dry_run)) || [[ -f $OMNIXY_SOURCE/flake.nix ]]; }; then
    args+=(--override-input omnixy "path:$OMNIXY_SOURCE")
  elif [[ $FLAKE_URL == "$DEFAULT_FLAKE_URL" && -n $OMNIXY_REV && $OMNIXY_REV != *dirty* ]]; then
    args+=(--override-input omnixy "$FLAKE_URL/$OMNIXY_REV")
  fi
  [[ -n $NIXPKGS_REV ]] && args+=(--override-input nixpkgs "github:NixOS/nixpkgs/$NIXPKGS_REV")
  if ((${#args[@]})); then
    run nix flake lock "$dir" "${args[@]}" && return 0
    notice "Could not pin to the live system's revisions; locking to the latest instead" 2
  fi
  run nix flake lock "$dir"
}

summary() {
  gum style --border rounded --border-foreground "$ACCENT" --padding "1 2" \
    "Keyboard   $keyboard_label" \
    "User       $username${full_name:+ ($full_name)}${email:+ <$email>}" \
    "Hostname   $hostname" \
    "Timezone   $timezone" \
    "Disk       $disk_label" \
    "Hardware   $hardware_summary" \
    "Encryption $( ((encrypt)) && echo "LUKS2" || echo "none")" \
    "Layout     1G EFI (/boot) + btrfs (@ @home @nix @log, zstd)" 2>/dev/null ||
    printf '%s\n' "keyboard=$keyboard_label user=$username hostname=$hostname timezone=$timezone disk=$disk encrypt=$encrypt"
}

# gum exits non-zero on Esc and Ctrl+C, which (under set -e) ends the run.
# Before the disk is touched that is a clean cancel.
touched_disk=0
on_exit() {
  local status=$?
  if ((status != 0)); then
    if ((touched_disk)); then
      printf '\n\033[31mInstallation failed.\033[0m Log: %s\n' "$LOG" >&2
    else
      printf '\nCancelled: nothing was changed.\n' >&2
    fi
  fi
  if [[ ${OMNIXY_INSTALL_PAUSE:-} == 1 ]] && interactive; then
    printf 'Press any key to close...'
    read -rsn 1 || true
  fi
}

main() {
  trap on_exit EXIT
  show_logo

  if ((!dry_run)); then
    [[ -d /sys/firmware/efi ]] || die "this machine booted without UEFI; OmniXY installs with systemd-boot and needs UEFI"
  fi

  ask_keyboard
  ask_username
  ask_password
  ask_identity
  ask_hostname
  ask_timezone
  ask_disk
  ask_encryption
  detect_hardware

  password_hash=$(openssl passwd -6 -stdin <<<"$password")

  if ((dry_run)); then
    work=${out_dir:-$(mktemp -d -t omnixy-install.XXXXXX)}
    mkdir -p "$work"
  else
    work=$(mktemp -d -t omnixy-install.XXXXXX)
  fi
  luks_key=/tmp/omnixy-luks.key
  mkdir -p "$work/etc-nixos"
  write_disko "$work/disko.nix"
  write_flake "$work/etc-nixos/flake.nix"
  write_configuration "$work/etc-nixos/configuration.nix"

  if interactive; then show_logo; fi
  summary
  echo
  confirm "Erase $disk_label and install OmniXY?" || exit 1

  if ((dry_run)); then
    write_placeholder_hardware "$work/etc-nixos/hardware-configuration.nix"
    local f
    for f in disko.nix etc-nixos/flake.nix etc-nixos/configuration.nix etc-nixos/hardware-configuration.nix; do
      printf '\n===== %s =====\n' "$f"
      cat "$work/$f"
    done
    printf '\n===== commands =====\n'
  else
    ensure_network
    # Log the install; keep the terminal on fds 3/4 for the final prompt.
    exec 3>&1 4>&2
    exec > >(tee -a "$LOG") 2>&1
  fi

  ((dry_run)) || touched_disk=1
  step "Partitioning $disk"
  if ((encrypt)); then
    printf '+ write the disk passphrase to %s (root, 0600)\n' "$luks_key"
    ((dry_run)) || printf '%s' "$password" | as_root install -m 0600 /dev/stdin "$luks_key"
  fi
  run disko --mode destroy,format,mount --yes-wipe-all-disks --root-mountpoint "$ROOT" "$work/disko.nix"
  ((encrypt)) && run rm -f "$luks_key"

  step "Writing $ROOT/etc/nixos"
  if ((dry_run)); then
    printf '+ nixos-generate-config --root %s --show-hardware-config > %s\n' "$ROOT" "$ROOT/etc/nixos/hardware-configuration.nix"
  else
    as_root nixos-generate-config --root "$ROOT" --show-hardware-config >"$work/etc-nixos/hardware-configuration.nix"
  fi
  run install -d -m 0755 "$ROOT/etc/nixos"
  run install -m 0644 -t "$ROOT/etc/nixos" "$work/etc-nixos/flake.nix" "$work/etc-nixos/configuration.nix" "$work/etc-nixos/hardware-configuration.nix"
  lock_flake "$ROOT/etc/nixos"

  step "Installing OmniXY (this takes a while)"
  run nixos-install --root "$ROOT" --flake "$ROOT/etc/nixos#$hostname" --no-root-passwd
  run ln -sfn "/etc/zoneinfo/$timezone" "$ROOT/etc/localtime"

  if ((dry_run)); then
    printf '\nDry run: nothing was changed. Generated files are in %s\n' "$work"
    return 0
  fi

  exec 1>&3 2>&4
  step "OmniXY is installed"
  [[ $reboot_after == no ]] && return 0
  if confirm "Reboot into OmniXY now?"; then
    sync
    as_root systemctl reboot
  fi
}

main
