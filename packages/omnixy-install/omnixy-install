#!/usr/bin/env bash
# omnixy-install: guided installer for the OmniXY live ISO.
#
# The NixOS take on Omarchy's ISO configurator: the same questions in the same
# order (keyboard, account, identity, hostname, timezone, disk, encryption),
# asked with gum. The answers become a disko layout, which partitions the disk,
# and a system flake in /mnt/etc/nixos that imports OmniXY, which nixos-install
# builds.
#
# Every answer can be given up front as an OMNIXY_INSTALL_* variable (see
# --help), which skips its prompt. With --dry-run nothing is touched: the
# generated files are written to a scratch directory and printed, together with
# the commands a real run would execute.

set -euo pipefail

DEFAULT_FLAKE_URL=github:TheArctesian/omnixy
FLAKE_URL=${OMNIXY_INSTALL_FLAKE_URL:-$DEFAULT_FLAKE_URL}
NIXPKGS_URL=${OMNIXY_INSTALL_NIXPKGS_URL:-github:NixOS/nixpkgs/nixos-unstable}
# Revisions the live ISO was built from (set by the package wrapper). Locking
# the new system to them means most of its closure is already in the live
# store, and OmniXY's own packages, which no binary cache carries, need no
# rebuild. OMNIXY_SOURCE is the ISO's own OmniXY source in the live store:
# locking to it works even when the ISO was built from a revision that is not
# on GitHub (or from a dirty tree); `omarchy-update` (nix flake update) moves
# the lock back to FLAKE_URL.
OMNIXY_SOURCE=${OMNIXY_INSTALL_OMNIXY_SOURCE:-}
OMNIXY_REV=${OMNIXY_INSTALL_OMNIXY_REV:-}
NIXPKGS_REV=${OMNIXY_INSTALL_NIXPKGS_REV:-}
STATE_VERSION=${OMNIXY_INSTALL_STATE_VERSION:-26.05}
LOGO=${OMNIXY_INSTALL_LOGO:-}
ROOT=/mnt
LOG=/tmp/omnixy-install.log

dry_run=0
assume_yes=0
reboot_after=ask
out_dir=""

ACCENT="#845DF9"

usage() {
  cat <<'USAGE'
Usage: omnixy-install [--dry-run] [--yes] [--out DIR] [--no-reboot]

Guided OmniXY installer. Asks for keyboard, account, identity, hostname,
timezone, target disk and encryption, partitions the disk with disko, writes a
system flake to /mnt/etc/nixos and runs nixos-install.

  --dry-run     Touch nothing: write the generated files to DIR (or a temp
                directory), print them and the commands a real run would run.
  --yes         Skip the confirmations (wipe, summary, reboot). Dangerous.
  --out DIR     Where --dry-run writes the generated files.
  --no-reboot   Do not offer to reboot at the end.
  -h, --help    Show this help.

Answers can be preset (their prompt is then skipped):

  OMNIXY_INSTALL_KEYBOARD    layout label ("English (UK)") or console keymap ("uk")
  OMNIXY_INSTALL_USERNAME    account name
  OMNIXY_INSTALL_PASSWORD    password (also the disk passphrase when encrypting)
  OMNIXY_INSTALL_FULL_NAME   git identity, may be empty
  OMNIXY_INSTALL_EMAIL       git identity, may be empty
  OMNIXY_INSTALL_HOSTNAME    host name, also the flake's nixosConfigurations name
  OMNIXY_INSTALL_TIMEZONE    e.g. Europe/London
  OMNIXY_INSTALL_DISK        whole disk to ERASE, e.g. /dev/nvme0n1
  OMNIXY_INSTALL_ENCRYPT     yes or no (LUKS2 full-disk encryption)

  OMNIXY_INSTALL_FLAKE_URL   OmniXY flake the new system follows
                             (default github:TheArctesian/omnixy)
USAGE
}

while (($#)); do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --yes | -y) assume_yes=1 ;;
    --no-reboot) reboot_after=no ;;
    --out)
      out_dir=${2:?--out needs a directory}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "omnixy-install: unknown option $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

# --- Presentation ----------------------------------------------------------

interactive() { [[ -t 0 && -t 1 ]]; }

show_logo() {
  interactive && clear
  if [[ -n $LOGO && -f $LOGO ]]; then
    printf '\033[32m%s\033[0m\n\n' "$(<"$LOGO")"
  fi
}

notice() {
  if interactive; then
    gum style --foreground 1 --padding "0 0 0 1" "$1"
    sleep "${2:-1}"
  else
    echo "omnixy-install: $1" >&2
  fi
}

step() { gum style --foreground "$ACCENT" --bold "● $*" 2>/dev/null || echo "● $*"; }

die() {
  echo "omnixy-install: $*" >&2
  exit 1
}

# Presets win; otherwise a missing answer needs a terminal to ask on.
preset() { [[ -n ${!1+x} ]]; }
need_tty() { interactive || die "no terminal to ask on; set $1"; }

confirm() {
  ((assume_yes)) && return 0
  interactive || die "confirmation needed ($1); pass --yes to run unattended"
  gum confirm --default=false "$1"
}

# --- The form ----------------------------------------------------------------
# Same fields, rules and keyboard list as upstream's install/provisioning/
# setup-form.sh, with an XKB layout next to each console keymap since NixOS
# sets both separately (Hyprland reads the XKB one from /etc/vconsole.conf).

# label|console keymap|xkb layout|xkb variant
